<Window x:Class="RehobothMediaPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Rehoboth Media Pro" Height="768" Width="1366"
        WindowStartupLocation="CenterScreen" WindowStyle="None" 
        AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <!-- GLOBAL ROUNDED BUTTON STYLE -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SIDEBAR GLOW & ACTIVE STYLE -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Margin" Value="10,5,10,5"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="20,0,0,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter Property="Background" Value="#2D3047"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6C5DD3"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CHROME-STYLE SCROLLBARS -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Border Background="Transparent"/>
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#4A4D67" CornerRadius="4" Margin="0"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- BIBLE CHAPTER PREVIEW TEMPLATES -->
        <DataTemplate x:Key="SingleLangTemplate">
            <StackPanel Margin="5,5,5,15">
                <TextBlock Text="{Binding PrimaryText}" FontFamily="pack://application:,,,/#Baloo Thambi 2" FontSize="16" Foreground="WhiteSmoke" VerticalAlignment="Top" TextWrapping="Wrap"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="DualLangTemplate">
            <Grid Margin="5,5,5,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- FIX: Restored clean, default text bindings so Secondary isn't invisible! -->
                <TextBlock Grid.Column="0" Text="{Binding PrimaryText}" FontSize="14" Foreground="WhiteSmoke" VerticalAlignment="Top" TextWrapping="Wrap"/>

                <Border Grid.Column="1" Width="1" Background="#2D3047" HorizontalAlignment="Center" VerticalAlignment="Stretch" Margin="0,5"/>

                <TextBlock Grid.Column="2" Text="{Binding SecondaryText}" FontSize="14" Foreground="WhiteSmoke" VerticalAlignment="Top" TextWrapping="Wrap"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border Background="#0F111A" CornerRadius="15" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <!-- NEW HAMBURGER BUTTON -->
                    <Button Content="☰" Width="40" Height="40" Background="Transparent" Foreground="White" FontSize="20" BorderThickness="0" HorizontalAlignment="Left" Margin="10,0,0,0" Cursor="Hand" Click="BtnToggleSidebar_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <Button Content="—" Width="30" Height="30" Background="Transparent" Foreground="Gray" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Width="30" Height="30" Background="Transparent" Foreground="Gray" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- LEFT SIDEBAR WRAPPER -->
            <Grid x:Name="SidebarWrapper" Grid.Row="1" Grid.Column="0" Width="255" ClipToBounds="True" CacheMode="BitmapCache">
                <Border Background="#1C1E30" CornerRadius="10" Margin="15,0,0,15" Width="240" HorizontalAlignment="Left">
                    <StackPanel Margin="0,20,0,0">
                        <TextBlock Text="Rehoboth Media" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="P R O" Foreground="#6C5DD3" FontSize="11" FontWeight="Heavy" HorizontalAlignment="Center" Margin="0,0,0,30" />

                        <Button x:Name="BtnMenuSongs" Content="🎵 Songs &amp; Lyrics" Style="{StaticResource MenuButton}" Click="BtnNavSongs_Click"/>
                        <Button x:Name="BtnMenuBible" Content="📖 VerseView Bible" Style="{StaticResource MenuButton}" Click="BtnNavBible_Click"/>
                        <Button x:Name="BtnMenuLowerThird" Content="📺 Lower Thirds" Style="{StaticResource MenuButton}" Click="BtnNavLowerThird_Click"/>
                        <Button x:Name="BtnMenuBirthdays" Content="🎂 Birthdays &amp; Anniversaries" Style="{StaticResource MenuButton}" Click="BtnNavBirthdays_Click"/>
                        <Button x:Name="BtnMenuRemote" Content="📱 Mobile Remote" Style="{StaticResource MenuButton}" Click="BtnNavRemote_Click"/>
                        <!-- NEW SETTINGS BUTTON -->
                        <Button x:Name="BtnMenuSettings" Content="⚙️ Settings" Style="{StaticResource MenuButton}" Margin="10,275,10,5" Click="BtnNavSettings_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MAIN CONTENT AREA -->
            <Border Grid.Row="1" Grid.Column="1" Background="#1C1E30" CornerRadius="10" Margin="15,0,15,15" Padding="20" PreviewMouseDown="MainContent_PreviewMouseDown">
                <Grid>

                    <!-- ======================================================= -->
                    <!-- 42 RULE LOCKED: SONG DASHBOARD -->
                    <!-- ======================================================= -->
                    <Grid x:Name="SongDashboard" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <!-- FIX: We need 5 rows to hold all 5 sections! -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- Row 0: Search -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 1: Fetch -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 2: Toggles -->
                                <RowDefinition Height="*"/>
                                <!-- Row 3: Lyrics Box (Stretches!) -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row 4: Buttons -->
                            </Grid.RowDefinitions>

                            <!-- ROW 0: Smart Dropdown & Sunday Setlist Queue -->
                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="140"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <Border Background="White" CornerRadius="8" BorderThickness="0">
                                            <TextBox x:Name="SongSearchBox" Height="35" FontSize="14" Background="Transparent" Foreground="Black" Padding="10,0" VerticalContentAlignment="Center" BorderThickness="0" TextChanged="SongSearchBox_TextChanged" KeyDown="SongSearchBox_KeyDown" GotFocus="SongSearchBox_GotFocus"/>
                                        </Border>

                                        <Popup x:Name="SongSuggestionPopup" PlacementTarget="{Binding ElementName=SongSearchBox}" StaysOpen="False" IsOpen="False" MaxHeight="300" MinWidth="{Binding ElementName=SongSearchBox, Path=ActualWidth}">
                                            <Border Background="White" BorderThickness="1" BorderBrush="Gray" CornerRadius="0,0,8,8" SnapsToDevicePixels="True" MaxWidth="500">
                                                <ListBox x:Name="SongSuggestionList" Background="Transparent" BorderThickness="0" Foreground="Black" FontSize="14" ScrollViewer.HorizontalScrollBarVisibility="Auto" PreviewMouseUp="SongSuggestionList_PreviewMouseUp" KeyDown="SongSuggestionList_KeyDown">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Padding" Value="10,8"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                                            <TextBlock Text="{Binding}" TextWrapping="NoWrap"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter Property="Background" Value="#6C5DD3"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                </ListBox>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                    <Button Grid.Column="1" Content="➕ Add to Setlist" Height="35" Padding="10,0" Margin="10,0,0,0" Background="#6C5DD3" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnAddToSetlist_Click"/>
                                </Grid>

                                <Border Grid.Row="1" Background="#0F111A" CornerRadius="8" BorderThickness="1" BorderBrush="#2D3047" Margin="0,15,0,0">
                                    <Grid>
                                        <TextBlock Text="Sunday Setlist Queue (Empty)" x:Name="LblSetlistEmpty" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="0"/>
                                        <ListBox x:Name="SetlistBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="14" Padding="5" SelectionChanged="SetlistBox_SelectionChanged" Panel.ZIndex="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" Foreground="WhiteSmoke"/>
                                                        <Button Grid.Column="1" Content="✕" Width="25" Height="25" Background="Transparent" Foreground="#FF4757" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="BtnRemoveFromSetlist_Click" Tag="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ROW 1: Action Bar -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Content="🌐 Fetch Web" Height="30" Background="#0085FF" Margin="0,0,10,0" Click="BtnFetchWeb_Click"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Font Size:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox x:Name="FontSizeBox" Text="45" Width="40" Height="30" TextAlignment="Center" Background="#2D3047" Foreground="White" BorderThickness="0" VerticalContentAlignment="Center"/>
                                    <Button Content="+" Width="30" Height="30" Background="#2D3047" Margin="2,0,0,0" Click="BtnIncreaseFont_Click"/>
                                    <Button Content="-" Width="30" Height="30" Background="#2D3047" Margin="2,0,0,0" Click="BtnDecreaseFont_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- ROW 2: Translation Toggles -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,10">
                                <CheckBox x:Name="chkDualEditor" Content="Dual Editor" Foreground="White" Margin="0,0,10,0" Click="ChkDualEditor_Click"/>
                                <CheckBox x:Name="chkOperatorMode" Content="I Don't Read Tamil" Foreground="#FF9F43" Margin="0,0,10,0" Click="ChkMode_Click"/>
                                <CheckBox x:Name="chkMultilingual" Content="Multilingual Live" Foreground="#00E5FF" Click="ChkMode_Click"/>
                            </StackPanel>

                            <!-- ROW 3: Split Lyrics Grid (Stretches to fill empty space!) -->
                            <Grid Grid.Row="3" x:Name="LyricsInputGrid" Margin="0,0,0,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="0" x:Name="SecEditorRowDef"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#0F111A" CornerRadius="12" Padding="10">
                                    <TextBox x:Name="LyricsInputBox" FontFamily="pack://application:,,,/#Baloo Thambi 2" CaretBrush="White" Background="Transparent" Foreground="White" FontSize="16" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False" />
                                </Border>

                                <Border x:Name="SecondaryEditorBorder" Grid.Row="2" Background="#1A1C29" CornerRadius="12" Padding="10" Visibility="Collapsed" BorderBrush="#00E5FF" BorderThickness="1">
                                    <Grid>
                                        <TextBlock Text="Tanglish / Secondary Language" Foreground="Gray" FontSize="11" Margin="0,0,0,5" VerticalAlignment="Top"/>
                                        <TextBox x:Name="SecondaryLyricsBox" Margin="0,20,0,0" CaretBrush="White" Background="Transparent" Foreground="#00E5FF" FontSize="15" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"/>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- ROW 4: Bottom Controls -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🗑 Delete" Width="80" Height="35" Background="#FF4757" Margin="0,0,10,0" Click="BtnDelete_Click"/>
                                <Button Grid.Column="1" Content="💾 Save" Width="80" Height="35" Background="#00B478" Click="BtnSave_Click"/>
                                <Button Grid.Column="3" Content="🚀 SUBMIT" Width="100" Height="35" Background="#6C5DD3" Click="BtnSubmit_Click"/>
                            </Grid>
                        </Grid>

                        <Border Grid.Column="1" Background="#0F111A" CornerRadius="8" Margin="20,0,0,0" Padding="15" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- FIX: Split Checkboxes and Buttons so they never get pushed off screen! -->
                                <Grid Grid.Row="0" Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <CheckBox x:Name="chkPresentation" Content="Presentation Mode" Foreground="White" VerticalAlignment="Center" Margin="0,0,0,8" Click="ChkPresentation_Click"/>
                                        <CheckBox x:Name="chkDualDisplay" Content="Enable Dual Monitors" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="✨ THEME" Height="35" Padding="10,0" Background="#6C5DD3" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand" Click="BtnThemeLogo_Click"/>
                                        <Button Content="🟩 GREEN SCREEN" Height="35" Padding="15,0" Background="#00B478" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand" Click="BtnGreenScreen_Click"/>
                                        <Button Content="✕ CLOSE" Height="35" Padding="15,0" Background="#FF4757" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCloseLive_Click"/>
                                    </StackPanel>
                                </Grid>

                                <UniformGrid x:Name="LyricsButtonGrid" Grid.Row="1" Columns="5" Rows="8" VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </Grid>


                    <!-- ======================================================= -->
                    <!-- VERSEVIEW BIBLE DASHBOARD -->
                    <!-- ======================================================= -->
                    <Grid x:Name="BibleDashboard" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Controls -->
                        <!-- LEFT COLUMN: Bible Controls & Styling -->
                        <Border Grid.Column="0" Background="#0F111A" CornerRadius="10" Padding="15" Margin="0,0,15,0">
                            <!-- FIX: Using a Grid with a * row ensures the ListBox gets exactly the remaining space! -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- All the fixed controls -->
                                    <RowDefinition Height="*"/>
                                    <!-- The expanding History List -->
                                </Grid.RowDefinitions>

                                <!-- Top Controls -->
                                <StackPanel Grid.Row="0" Margin="0,0,5,0">
                                    <TextBlock Text="Smart Search" Foreground="#6C5DD3" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                    <TextBlock Text="e.g. 'Gen', 'Est 1', or '1 jo 1 1'" Foreground="LightGray" FontSize="11" Margin="0,0,0,5"/>
                                    <Border Background="#1C1E30" CornerRadius="8" BorderThickness="1" BorderBrush="#6C5DD3" Margin="0,0,0,15" Padding="10,0">
                                        <TextBox x:Name="BibleSearchBox" Height="30" Background="Transparent" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" VerticalContentAlignment="Center" KeyDown="BibleSearchBox_KeyDown" PreviewMouseDown="BibleSearchBox_PreviewMouseDown" CaretBrush="White"/>
                                    </Border>

                                    <TextBlock Text="Languages (Check &amp; Reorder)" Foreground="#6C5DD3" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                    <!-- NEW: Interactive Reorder List! -->
                                    <Border Background="#1C1E30" CornerRadius="5" Padding="5" Margin="0,0,0,15">
                                        <ListBox x:Name="LanguageOrderList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="LtImageGalleryList_PreviewMouseWheel" Margin="0,0,0,15">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="5"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <!-- Slight hover effect so you know what you are selecting -->
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#2D3047"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <!-- 1. The Checkbox -->
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsActive}" VerticalAlignment="Center" Margin="0,0,10,0" Click="LanguageCheckbox_Click"/>
                                                        <!-- 2. The Language Name -->
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="White" VerticalAlignment="Center"/>
                                                        <!-- 3. The Move Up/Down Buttons -->
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                            <Button Content="▲" Width="25" Height="25" Background="#2D3047" Foreground="White" FontSize="10" Margin="0,0,5,0" Cursor="Hand" Click="BtnMoveLangUp_Click" Tag="{Binding}"/>
                                                            <Button Content="▼" Width="25" Height="25" Background="#2D3047" Foreground="White" FontSize="10" Cursor="Hand" Click="BtnMoveLangDown_Click" Tag="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Border>
                                    <TextBlock Text="Custom Styling" Foreground="#6C5DD3" FontWeight="Bold" FontSize="14" Margin="0,15,0,5"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Verse Font:" Foreground="LightGray" FontSize="11" Grid.Row="0" Grid.Column="0"/>
                                        <ComboBox x:Name="CbVerseFont" Grid.Row="1" Grid.Column="0" Margin="0,0,5,5" SelectionChanged="BibleStyle_Changed"/>
                                        <TextBlock Text="Verse Color:" Foreground="LightGray" FontSize="11" Grid.Row="0" Grid.Column="1"/>
                                        <ComboBox x:Name="CbVerseColor" Grid.Row="1" Grid.Column="1" Margin="5,0,0,5" SelectionChanged="BibleStyle_Changed"/>
                                        <TextBlock Text="Ref Font:" Foreground="LightGray" FontSize="11" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"/>
                                        <ComboBox x:Name="CbRefFont" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,0" SelectionChanged="BibleStyle_Changed"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Font Size Override:" Foreground="LightGray" FontSize="12" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Button Content="+" Width="30" Height="30" Background="#2D3047" Margin="0,0,3,0" Click="BtnBibleFontUp_Click"/>
                                        <Button Content="-" Width="30" Height="30" Background="#2D3047" Margin="0,0,3,0" Click="BtnBibleFontDown_Click"/>
                                        <Button Content="↺ Reset" Width="55" Height="30" Background="#FF4757" Click="BtnBibleFontReset_Click"/>
                                    </StackPanel>

                                    <TextBlock Text="Font Weight:" Foreground="LightGray" FontSize="11" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <CheckBox x:Name="chkPriBold" Content="Primary Bold" Foreground="White" IsChecked="True" Margin="0,0,15,0" Click="BibleStyle_Changed"/>
                                        <CheckBox x:Name="chkSecBold" Content="Secondary Bold" Foreground="White" IsChecked="True" Click="BibleStyle_Changed"/>
                                    </StackPanel>

                                    <TextBlock Text="Recent Verses" Foreground="#6C5DD3" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
                                </StackPanel>

                                <!-- Bottom: Scrolling History List -->
                                <!-- FIX: The ListBox is directly inside the * row, forcing it to stretch to the bottom with a perfect scrollbar! -->
                                <ListBox x:Name="HistoryList" Grid.Row="1" Background="#1C1E30" BorderThickness="0" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="HistoryList_SelectionChanged" Padding="5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Padding="5" Cursor="Hand" FontSize="12"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- RIGHT COLUMN: Massive Chapter Preview & Live Controls -->
                        <Border Grid.Column="1" Background="#1C1E30" CornerRadius="10" Padding="20" Margin="0,0,15,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <!-- Top Controls -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Title -->
                                    <RowDefinition Height="*"/>
                                    <!-- Chapter List -->
                                    <RowDefinition Height="Auto"/>
                                    <!-- Bottom Controls -->
                                </Grid.RowDefinitions>

                                <!-- Top: Live Display Controls -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                                    <Button Content="✨ THEME" Height="35" Padding="15,0" Background="#6C5DD3" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand" Click="BtnThemeLogo_Click"/>
                                    <Button Content="🟩 GREEN SCREEN" Height="35" Padding="15,0" Background="#00B478" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand" Click="BtnGreenScreen_Click"/>
                                    <Button Content="✕ CLOSE" Height="35" Padding="15,0" Background="#FF4757" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCloseLive_Click"/>
                                </StackPanel>

                                <!-- Chapter Title -->
                                <TextBlock x:Name="LblChapterTitle" Grid.Row="1" Text="Chapter Preview" Foreground="#00B478" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                <!-- FIX: Removed the buggy background line. The ListBox now stretches 100% width! -->
                                <ListBox x:Name="ChapterVerseList" Grid.Row="2" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="False" SelectionChanged="ChapterVerseList_SelectionChanged" HorizontalContentAlignment="Stretch" PreviewMouseLeftButtonUp="ChapterVerseList_PreviewMouseLeftButtonUp">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="VerticalContentAlignment" Value="Top"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="BorderBrush" Value="#2D3047"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="Padding" Value="10"/>
                                            <!-- FIX: Forces a permanent Purple highlight when selected! -->
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#6C5DD3"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>

                                <!-- Bottom: Prev/Next Controls -->
                                <Grid Grid.Row="3" Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="⬅️ PREV VERSE" Height="45" Background="#2D3047" FontWeight="Bold" Click="BtnPrevVerse_Click"/>
                                    <Button Grid.Column="2" Content="NEXT VERSE ➡️" Height="45" Background="#2D3047" FontWeight="Bold" Click="BtnNextVerse_Click"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <!-- ======================================================= -->
                    <!-- MOBILE REMOTE DASHBOARD -->
                    <!-- ======================================================= -->
                    <Grid x:Name="RemoteDashboard" Visibility="Collapsed">
                        <Border Background="#0F111A" CornerRadius="10" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📱 Mobile Remote Control" Foreground="#6C5DD3" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Control the live stream lyrics and bible verses directly from your phone!" Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                                <Button x:Name="BtnToggleServer" Content="🚀 START SERVER" Height="50" Width="250" Background="#00B478" Foreground="White" FontWeight="Bold" FontSize="16" Cursor="Hand" Click="BtnToggleServer_Click"/>

                                <StackPanel x:Name="ServerInfoPanel" Visibility="Collapsed" Margin="0,40,0,0">
                                    <TextBlock Text="Server is Running! Scan the QR Code on your phone:" Foreground="#00B478" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                    <!-- NEW: The QR Code Image Container! -->
                                    <Border Background="White" Padding="10" CornerRadius="10" HorizontalAlignment="Center" Margin="0,0,0,15">
                                        <Image x:Name="QrCodeImage" Width="180" Height="180" Stretch="Uniform"/>
                                    </Border>

                                    <TextBlock Text="Or open this URL in your browser:" Foreground="Gray" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBox x:Name="ServerUrlBox" Text="http://192.168.1.5:8080/" Background="Transparent" Foreground="White" FontSize="20" FontWeight="Bold" TextAlignment="Center" BorderThickness="0" IsReadOnly="True" Margin="0,0,0,20"/>

                                    <TextBlock Text="(Make sure your phone is connected to the same Wi-Fi as this computer)" Foreground="#A0A5C0" FontSize="11" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- ======================================================= -->
                    <!-- LOWER THIRDS DASHBOARD (With True Live Monitor!) -->
                    <!-- ======================================================= -->
                    <Grid x:Name="LowerThirdDashboard" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="380"/>
                            <!-- Left: 4 Media Cards -->
                            <ColumnDefinition Width="*"/>
                            <!-- Right: True Live Monitor -->
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: The Media Cards -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,15,0">
                            <StackPanel Margin="0,0,10,0">

                                <!-- CARD 1: Broadcast Customizer -->
                                <Border Background="#1C1E30" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="Broadcast Customizer" Foreground="#6C5DD3" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                                <RowDefinition/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="Theme Style:" Foreground="LightGray" FontSize="11" Grid.Row="0" Grid.Column="0"/>
                                            <ComboBox x:Name="CbLtTheme" Grid.Row="1" Grid.Column="0" Margin="0,0,0,10" Background="White" Foreground="Black">
                                                <ComboBoxItem Content="Indigo (Classic)" Tag="linear-gradient(135deg, #4A00E0, #8E2DE2)"/>
                                                <ComboBoxItem Content="Crimson (News)" Tag="linear-gradient(135deg, #ff0844, #ffb199)"/>
                                                <ComboBoxItem Content="Emerald (Fresh)" Tag="linear-gradient(135deg, #11998e, #38ef7d)"/>
                                                <ComboBoxItem Content="Midnight (Sleek)" Tag="#1A1A1A"/>
                                            </ComboBox>

                                            <TextBlock Text="Accent Line:" Foreground="LightGray" FontSize="11" Grid.Row="0" Grid.Column="2"/>
                                            <ComboBox x:Name="CbLtAccent" Grid.Row="1" Grid.Column="2" Margin="0,0,0,10" Background="White" Foreground="Black">
                                                <ComboBoxItem Content="Cyan" Tag="#00E5FF"/>
                                                <ComboBoxItem Content="Gold" Tag="#FFD700"/>
                                                <ComboBoxItem Content="White" Tag="#FFFFFF"/>
                                                <ComboBoxItem Content="Red" Tag="#FF4757"/>
                                            </ComboBox>

                                            <TextBlock Text="Font Style:" Foreground="LightGray" FontSize="11" Grid.Row="2" Grid.Column="0"/>
                                            <ComboBox x:Name="CbLtFont" Grid.Row="3" Grid.Column="0" Margin="0,0,0,10" Background="White" Foreground="Black">
                                                <ComboBoxItem Content="Segoe UI"/>
                                                <ComboBoxItem Content="Impact"/>
                                                <ComboBoxItem Content="Trebuchet MS"/>
                                                <ComboBoxItem Content="Georgia"/>
                                            </ComboBox>

                                            <TextBlock Text="Animation Design:" Foreground="LightGray" FontSize="11" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"/>
                                            <ComboBox x:Name="CbLtDesign" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Background="White" Foreground="Black">
                                                <ComboBoxItem Content="1. Broadcast (Slide Left)"/>
                                                <ComboBoxItem Content="2. Minimalist (Line Expand)"/>
                                                <ComboBoxItem Content="3. Elegant (Center Fade up)"/>
                                                <ComboBoxItem Content="4. Clean Glass (Blur Drop)"/>
                                                <ComboBoxItem Content="5. Neon Cyber (Glowing Edges)"/>
                                                <ComboBoxItem Content="6. Corporate Sharp (Bottom Up)"/>
                                                <ComboBoxItem Content="7. News Ticker (Full Width)"/>
                                                <ComboBoxItem Content="8. Bouncing Pill (Pop In)"/>
                                                <ComboBoxItem Content="9. Split Horizon (Double Line)"/>
                                                <ComboBoxItem Content="10. Cinematic (Slow Zoom)"/>
                                                <ComboBoxItem Content="11. Minimal Outline (Box Draw)"/>
                                                <ComboBoxItem Content="12. Right-Side Frosted (Slide Right)"/>
                                                <ComboBoxItem Content="13. Bold Block (Heavy Drop)"/>
                                                <ComboBoxItem Content="14. Elegant Ribbon (Fade Right)"/>
                                                <ComboBoxItem Content="15. Dynamic Tech (Skewed)"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 2: Text & Titles -->
                                <Border Background="#1C1E30" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="Text &amp; Titles (Pastor Names)" Foreground="#6C5DD3" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                                        <TextBlock Text="Primary Name:" Foreground="LightGray" FontSize="11" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="CbLtText" Height="35" Background="White" Foreground="Black" FontSize="14" IsEditable="True" Margin="0,0,0,10" Padding="5"/>
                                        <TextBlock Text="Subtitle / Role (Optional):" Foreground="LightGray" FontSize="11" Margin="0,0,0,5"/>
                                        <Border Background="White" CornerRadius="4" Margin="0,0,0,15">
                                            <TextBox x:Name="TxtLtRole" Height="30" Background="Transparent" Foreground="Black" FontSize="14" BorderThickness="0" Padding="5" VerticalContentAlignment="Center"/>
                                        </Border>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="➕ Add Name" Height="30" Background="#2D3047" Cursor="Hand" Click="BtnAddLtText_Click"/>
                                            <Button Grid.Column="2" Content="❌ Remove" Height="30" Background="#FF4757" Cursor="Hand" Click="BtnRemoveLtText_Click"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="👁 PREVIEW" Height="35" Background="#FF9F43" Foreground="Black" FontWeight="Bold" Cursor="Hand" Click="BtnPreviewLtText_Click"/>
                                            <Button Grid.Column="2" x:Name="BtnSubmitLtText" Content="🚀 GO LIVE!" Height="35" Background="#00B478" FontWeight="Bold" Cursor="Hand" Click="BtnSubmitLtText_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 2: Images & Logos -->
                                <!-- FIX: AllowDrop enabled for Drag & Drop support! -->
                                <Border Background="#1C1E30" CornerRadius="10" Padding="15" Margin="0,0,0,15" AllowDrop="True" Drop="ImageCard_Drop" DragOver="ImageCard_DragOver">
                                    <StackPanel>
                                        <TextBlock Text="Images &amp; Logos (Drag &amp; Drop)" Foreground="#6C5DD3" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="🖼️ Browse Images" Height="35" Background="#2D3047" Cursor="Hand" Click="BtnBrowseLtImage_Click"/>
                                            <CheckBox x:Name="chkLtPortrait" Grid.Column="2" Content="Portrait Mode" Foreground="White" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>

                                        <!-- FIX: The ListBox now has a physical ScrollViewer wrapper that handles all scrolling! -->
                                        <!-- FIX: Replaced ListBox with ItemsControl to completely eradicate the click and scroll bugs! -->
                                        <ScrollViewer Height="100" Background="#1C1E30" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="LtImageGalleryList_PreviewMouseWheel" Margin="0,0,0,15">
                                            <ItemsControl x:Name="LtImageGalleryList">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- The Border itself handles the click! -->
                                                        <Border BorderThickness="3" CornerRadius="5" Margin="0,0,10,0" BorderBrush="{Binding BorderColor}" Cursor="Hand" MouseLeftButtonUp="GalleryImage_Click" Tag="{Binding FilePath}">
                                                            <Grid Background="Transparent">
                                                                <Image Source="{Binding ImageSource}" Width="90" Height="50" Stretch="UniformToFill"/>
                                                                <Button Content="✕" Width="20" Height="20" Background="Red" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" FontSize="10" Cursor="Hand" Click="BtnDeleteLtImage_Click" Tag="{Binding FilePath}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <!-- FIX: Preview button removed. Push Live is now full-width! -->
                                        <Button x:Name="BtnSubmitLtImage" Content="🚀 PUSH LIVE" Height="35" Background="#00B478" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnSubmitLtImage_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- CARD 4: Video Animations (FIXED BUTTONS!) -->
                                <Border Background="#1C1E30" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                                    <StackPanel>
                                        <TextBlock Text="Video Animations (MP4)" Foreground="#6C5DD3" FontWeight="Bold" FontSize="16" Margin="0,0,0,15"/>
                                        <ComboBox x:Name="CbLtVideo" Height="35" Background="White" Foreground="Black" FontSize="14" Margin="0,0,0,10" Padding="5"/>
                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📂 Browse New" Height="30" Background="#2D3047" Cursor="Hand" Click="BtnBrowseLtVideo_Click"/>
                                            <Button Grid.Column="2" Content="❌ Remove" Height="30" Background="#FF4757" Cursor="Hand" Click="BtnRemoveLtVideo_Click"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="👁 PREVIEW" Height="35" Background="#FF9F43" Foreground="Black" FontWeight="Bold" Cursor="Hand" Click="BtnPreviewLtVideo_Click"/>
                                            <Button x:Name="BtnSubmitLtVideo" Grid.Column="2" Content="🚀 PUSH LIVE" Height="35" Background="#00B478" FontWeight="Bold" Cursor="Hand" Click="BtnSubmitLtVideo_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- RIGHT COLUMN: TRUE LIVE MONITOR & Controls -->
                        <Border Grid.Column="1" Background="#0F111A" CornerRadius="10" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Live Controls -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15">
                                    <Button Content="🟩 GREEN SCREEN" Height="35" Width="140" Background="#00B478" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand" Click="BtnGreenScreen_Click"/>
                                    <Button Content="✕ CLOSE" Height="35" Width="100" Background="#FF4757" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCloseLive_Click"/>
                                </StackPanel>

                                <!-- NEW: The Embedded Live Monitor! -->
                                <Border Grid.Row="1" Background="#1C1E30" CornerRadius="10" Margin="0,15" ClipToBounds="True">
                                    <wv2:WebView2 x:Name="MiniPreviewMonitor" />
                                </Border>

                                <!-- Unified Video Media Controls -->
                                <StackPanel Grid.Row="2" Margin="0,15,0,0">
                                    <TextBlock Text="Video Playback Controls:" Foreground="#6C5DD3" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Seek:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                        <!-- The Magical Syncing Slider! -->
                                        <Slider x:Name="VideoSeekBar" Grid.Column="1" Minimum="0" Maximum="100" Value="0" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Cursor="Hand" ValueChanged="VideoSeekBar_ValueChanged"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- PREVIEW Controls -->
                                        <Button x:Name="BtnPreviewPlayPause" Grid.Column="0" Content="⏸ PAUSE PREVIEW" Height="40" Background="#FF9F43" Foreground="Black" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnPreviewPlayPause_Click"/>
                                        <!-- LIVE Controls -->
                                        <Button x:Name="BtnLtPlayPause" Grid.Column="2" Content="⏸ PAUSE LIVE" Height="40" Background="#6C5DD3" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnLtPlayPause_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ======================================================= -->
                    <!-- BIRTHDAYS & ANNIVERSARIES DASHBOARD (Editable!) -->
                    <!-- ======================================================= -->
                    <Grid x:Name="BirthdayDashboard" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- TOP: Database Controls & Live Display -->
                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ROW 1: Import, Load, and Search -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <Button Content="📂 IMPORT EXCEL TO DB" Height="35" Width="180" Background="#6C5DD3" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnImportExcel_Click" Margin="0,0,10,0"/>
                                <Button Content="📅 LOAD THIS WEEK" Height="35" Width="150" Background="#00B478" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnLoadWeek_Click" Margin="0,0,10,0"/>
                                <Button Content="🗃️ VIEW ENTIRE DB" Height="35" Width="140" Background="#2D3047" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnLoadAll_Click" Margin="0,0,25,0"/>

                                <TextBlock Text="🔍 Search:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                                <TextBox x:Name="EventSearchBox" Width="130" Height="35" Background="#1C1E30" Foreground="White" BorderThickness="1,1,0,1" BorderBrush="#6C5DD3" Padding="10,0" VerticalContentAlignment="Center" CaretBrush="White" KeyDown="EventSearchBox_KeyDown"/>
                                <Button Content="Search" Width="60" Height="35" Background="#6C5DD3" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Click="BtnEventSearch_Click"/>
                                <Button Content="↩ UNDO SAVE" Width="100" Height="35" Background="#FF4757" Foreground="White" FontWeight="Bold" Cursor="Hand" BorderThickness="0" Margin="10,0,0,0" Click="BtnUndoEventSave_Click"/>
                                <Border Background="#1C1E30" CornerRadius="8" Padding="10,5" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Custom Fonts:" Foreground="#E91E63" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Content="Change Title Font" Height="25" Padding="10,0" Background="#2D3047" Foreground="White" Cursor="Hand" Margin="0,0,5,0" Click="BtnUploadTitleFont_Click"/>
                                        <Button Content="Change Name Font" Height="25" Padding="10,0" Background="#2D3047" Foreground="White" Cursor="Hand" Click="BtnUploadNameFont_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ROW 2: Live Controls & Scroller -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border Background="#1C1E30" CornerRadius="8" Padding="10,5" Margin="0,0,15,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Scroll Speed:" Foreground="LightGray" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Slider x:Name="EventScrollSpeed" Width="80" Minimum="1" Maximum="10" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                        <Button x:Name="BtnEventScroll" Content="▶ START SCROLL" Height="25" Padding="10,0" Background="#2D3047" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnEventScroll_Click"/>
                                    </StackPanel>
                                </Border>

                                <Button Content="🟩 GREEN SCREEN" Height="35" Padding="15,0" Background="#00B478" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" Cursor="Hand" Click="BtnGreenScreen_Click"/>
                                <Button Content="✕ CLOSE" Height="35" Padding="15,0" Background="#FF4757" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnCloseLive_Click"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: Birthdays Editable Grid -->
                            <Border Grid.Column="0" Background="#1C1E30" CornerRadius="10" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <!-- Manual Add Bar -->
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="🎂 Birthdays (Double-click to edit!)" Foreground="#00E5FF" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                    <!-- RESTORED: Manual Entry Bar with Date Picker Trigger! -->
                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0F111A" CornerRadius="5" Margin="0,0,5,0">
                                            <TextBox x:Name="TxtBdayName" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" FontSize="14"/>
                                        </Border>
                                        <Border Grid.Column="1" Background="#0F111A" CornerRadius="5" Margin="0,0,5,0">
                                            <TextBox x:Name="TxtBdayDate" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" FontSize="14" IsReadOnly="True" Cursor="Hand" PreviewMouseDown="TxtBdayDate_PreviewMouseDown" Text="Date..."/>
                                        </Border>
                                        <Button Grid.Column="2" Content="➕ ADD" Background="#2D3047" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnAddBday_Click"/>
                                    </Grid>

                                    <!-- The DataGrid -->
                                    <DataGrid x:Name="GridBdays" Grid.Row="2" SelectionChanged="GridBdays_SelectionChanged" AutoGenerateColumns="False" Background="#0F111A" Foreground="Black" RowBackground="White" AlternatingRowBackground="#F0F0F0" HeadersVisibility="Column" CanUserAddRows="False" Margin="0,0,0,15">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="❌ Clear Screen" Height="40" Background="#FF9F43" FontWeight="Bold" Cursor="Hand" Click="BtnClearBdays_Click"/>
                                        <Button x:Name="BtnDelBdayRow" Grid.Column="2" Content="🗑 Delete Row" Height="40" Background="#FF4757" FontWeight="Bold" Cursor="Hand" Click="BtnDeleteBdayRow_Click" Visibility="Hidden"/>
                                        <Button Grid.Column="4" Content="💾 UPDATE DB" Height="40" Background="#2D3047" FontWeight="Bold" Cursor="Hand" Click="BtnSaveBdayDb_Click"/>
                                        <Button Grid.Column="6" Content="🚀 PUSH LIVE" Height="40" Background="#00B478" FontWeight="Bold" Cursor="Hand" Click="BtnSubmitBdays_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- RIGHT: Anniversaries Editable Grid -->
                            <Border Grid.Column="2" Background="#1C1E30" CornerRadius="10" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <!-- Manual Add Bar -->
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="💍 Anniversaries (Double-click to edit!)" Foreground="#E91E63" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                                    <!-- RESTORED: Manual Entry Bar with Date Picker Trigger! -->
                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Background="#0F111A" CornerRadius="5" Margin="0,0,5,0">
                                            <TextBox x:Name="TxtAnnivName" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" FontSize="14"/>
                                        </Border>
                                        <Border Grid.Column="1" Background="#0F111A" CornerRadius="5" Margin="0,0,5,0">
                                            <TextBox x:Name="TxtAnnivDate" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,0" VerticalContentAlignment="Center" FontSize="14" IsReadOnly="True" Cursor="Hand" PreviewMouseDown="TxtAnnivDate_PreviewMouseDown" Text="Date..."/>
                                        </Border>
                                        <Button Grid.Column="2" Content="➕ ADD" Background="#2D3047" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnAddAnniv_Click"/>
                                    </Grid>

                                    <!-- The DataGrid -->
                                    <DataGrid x:Name="GridAnnivs" Grid.Row="2" SelectionChanged="GridAnnivs_SelectionChanged" AutoGenerateColumns="False" Background="#0F111A" Foreground="Black" RowBackground="White" AlternatingRowBackground="#F0F0F0" HeadersVisibility="Column" CanUserAddRows="False" Margin="0,0,0,15">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Couple Names" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="5"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="❌ Clear Screen" Height="40" Background="#FF9F43" FontWeight="Bold" Cursor="Hand" Click="BtnClearAnnivs_Click"/>
                                        <Button x:Name="BtnDelAnnivRow" Grid.Column="2" Content="🗑 Delete Row" Height="40" Background="#FF4757" FontWeight="Bold" Cursor="Hand" Click="BtnDeleteAnnivRow_Click" Visibility="Hidden"/>
                                        <Button Grid.Column="4" Content="💾 UPDATE DB" Height="40" Background="#2D3047" FontWeight="Bold" Cursor="Hand" Click="BtnSaveAnnivDb_Click"/>
                                        <Button Grid.Column="6" Content="🚀 PUSH LIVE" Height="40" Background="#00B478" FontWeight="Bold" Cursor="Hand" Click="BtnSubmitAnnivs_Click"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    <!-- ======================================================= -->
                    <!-- GLOBAL SETTINGS DASHBOARD -->
                    <!-- ======================================================= -->
                    <Grid x:Name="SettingsDashboard" Visibility="Collapsed">
                        <Border Background="#1C1E30" CornerRadius="10" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="⚙️ Global Settings" Foreground="#6C5DD3" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Configure global app behaviors and default media." Foreground="LightGray" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                                <Grid>
                                    <!-- FIX: Explicitly defines all 5 columns so the compiler builds them perfectly! -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="320"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="320"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- COLUMN 1: Backgrounds & Themes -->
                                    <StackPanel Grid.Column="0">
                                        <Border Background="#0F111A" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                                            <StackPanel>
                                                <TextBlock Text="Default Background Theme Loop" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                                <TextBlock Text="This video plays silently on a continuous loop on the Live Display." Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                                <Button Content="📂 Upload Theme Video" Height="35" Background="#6C5DD3" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnUploadThemeVideo_Click" Margin="0,0,0,10"/>
                                                <Button Content="❌ Restore Black Screen" Height="35" Background="#FF4757" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnRestoreBlackTheme_Click"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#0F111A" CornerRadius="10" Padding="20">
                                            <StackPanel>
                                                <TextBlock Text="Bible Background Gallery" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Content="🖼️ Add Image" Height="30" Background="#2D3047" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnAddBibleBg_Click"/>
                                                    <Button Grid.Column="2" Content="⬛ Solid Black" Height="30" Background="#FF4757" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClearBibleBg_Click"/>
                                                </Grid>
                                                <ListBox x:Name="BgGalleryList" Height="70" Background="#1C1E30" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="BgGalleryList_SelectionChanged">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <VirtualizingStackPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderThickness="3" CornerRadius="5" Margin="0,0,10,0" BorderBrush="{Binding BorderColor}">
                                                                <Grid>
                                                                    <Image Source="{Binding ImageSource}" Width="90" Height="50" Stretch="UniformToFill" Cursor="Hand"/>
                                                                    <Button Content="✕" Width="20" Height="20" Background="Red" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" FontSize="10" Cursor="Hand" Click="BtnDeleteBibleBg_Click" Tag="{Binding FilePath}"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- COLUMN 2: Fonts & Animations -->
                                    <StackPanel Grid.Column="2">
                                        <Border Background="#0F111A" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                                            <StackPanel>

                                                <TextBlock Text="Live Display Animations" Foreground="#6C5DD3" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                                <CheckBox x:Name="chkAnimBible" Content="Enable Bible Verse Fades" Foreground="White" IsChecked="True" Margin="0,0,0,5"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <TextBlock Text="Fade Speed (ms):" Foreground="LightGray" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Slider x:Name="BibleAnimSpeed" Width="100" Minimum="100" Maximum="2000" Value="400" TickFrequency="100" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <CheckBox x:Name="chkAnimSong" Content="Enable Presentation Gradients/Fades" Foreground="White" IsChecked="True" Margin="0,0,0,5"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                    <TextBlock Text="Fade Speed (ms):" Foreground="LightGray" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <Slider x:Name="SongAnimSpeed" Width="100" Minimum="100" Maximum="2000" Value="500" TickFrequency="100" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <Button Content="💾 SAVE SETTINGS" Height="30" Background="#00B478" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnSaveSettings_Click"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- COLUMN 3: Gradients & Cloud Sync -->
                                    <StackPanel Grid.Column="4">
                                        <Border Background="#0F111A" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                                            <StackPanel>
                                                <TextBlock Text="Presentation Mode Gradient" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="BtnGrad1" Grid.Column="0" Content="Pick Color 1" Height="35" Background="#0f2027" Foreground="White" Margin="0,0,5,0" Cursor="Hand" Click="BtnPickGrad1_Click" BorderThickness="1" BorderBrush="White"/>
                                                    <Button x:Name="BtnGrad2" Grid.Column="1" Content="Pick Color 2" Height="35" Background="#2c5364" Foreground="White" Margin="5,0,0,0" Cursor="Hand" Click="BtnPickGrad2_Click" BorderThickness="1" BorderBrush="White"/>
                                                </Grid>
                                                <Button Content="💾 SAVE GRADIENT" Height="30" Background="#00B478" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnSaveGradient_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- NEW: Safe Database Cleaner -->
                                        <Border Background="#0F111A" CornerRadius="10" Padding="20">
                                            <StackPanel>
                                                <TextBlock Text="Database Maintenance" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                                <TextBlock Text="Safely cleans up your hard drive by scanning for and deleting any empty or broken ghost files." Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                                <Button Content="🧹 PURGE EMPTY FILES" Height="30" Background="#FF4757" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="BtnPurgeEmptySongs_Click"/>
                                            </StackPanel>
                                        </Border>

                                        
                                    </StackPanel>

                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
            <!-- NEW: The Custom Day/Month Picker Popup! -->
            <Popup x:Name="DateSelectorPopup" StaysOpen="False" Placement="MousePoint" AllowsTransparency="True">
                <Border Background="#1C1E30" BorderBrush="#6C5DD3" BorderThickness="2" CornerRadius="10" Padding="15" Width="250">
                    <StackPanel>
                        <TextBlock Text="Select Date" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Day" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
                                <ListBox x:Name="ListDays" Height="150" Background="#0F111A" Foreground="White" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="DateList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Month" Foreground="LightGray" FontSize="12" HorizontalAlignment="Center"/>
                                <ListBox x:Name="ListMonths" Height="150" Background="#0F111A" Foreground="White" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="DateList_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                            <Setter Property="Padding" Value="5"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </Grid>
                        <Button Content="✔ APPLY DATE" Height="30" Background="#00B478" Foreground="White" FontWeight="Bold" Margin="0,15,0,0" Cursor="Hand" Click="BtnApplyDate_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>